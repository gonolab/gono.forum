## The admin module "Languages": the site language, translation progress and customized text by language.

language-saved = Site language saved.
language-site-heading = Site language
# $domains_html links to the multi-domain module.
language-site-intro = The language of the whole interface, of emails sent by background tasks and of outward content such as the sitemap. Other domains can each choose their own under { $domains_html }; text a language lacks is shown in English. Members cannot switch languages themselves.
# One site language option: the language's own name, its tag and how complete it is.
language-option = { $name } ({ $tag }) · { $percent }%
language-progress-heading = Translation progress
language-progress-intro = Progress counts the keys of the English base; English is the base and always complete. Translations come from the community through pull requests and ship with releases.
language-column-language = Language
language-column-tag = Tag
language-column-progress = Progress
language-column-used = Used by
language-progress = { $percent }% ({ $translated } / { $total })
language-used-site = Whole site
language-localized-heading = Customized text by language
# $templates_html links to the mail template editor.
language-localized-intro = Mail templates and policies are stored once per language; a language without its own text uses its built-in text. To edit, switch the language on { $templates_html } or on a policy page.
language-localized-none = Nothing customized; all built-in text.
# $label is the kind of mail.
language-text-mail = Mail template · { $label }
# $label is the kind of policy.
language-text-policy = Policy · { $label }
language-description = The site language, translation progress and customized text by language
language-error-unknown = Choose one of the built-in languages
