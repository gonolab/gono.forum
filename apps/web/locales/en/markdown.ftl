## Interface text the Markdown renderer writes into post bodies (markdown.rs). Bodies are cached per language.

# The summary line of a spoiler block.
markdown-spoiler = Show spoiler
# The caption of a YouTube placeholder whose link has no text of its own.
markdown-video-title = YouTube video
markdown-video-notice = After you click "Load player", your browser connects to youtube-nocookie.com, and YouTube (Google) receives your IP address and this site's domain; playing may store cookies and other local data. Nothing connects until you click.
markdown-video-load = Load player
markdown-video-open = Open on YouTube
